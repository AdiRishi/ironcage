{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ironcage-compute",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "dev": {
    "port": 8789,
    "inspector_port": 9231,
  },
  "durable_objects": {
    "bindings": [{ "name": "BACKTEST", "class_name": "BacktestRunner" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BacktestRunner"] }],
}
