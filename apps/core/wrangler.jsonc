{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ironcage-core",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "dev": {
    "port": 8787,
    "inspector_port": 9229,
  },
  // Targeting the entrypoint, not just the Worker, is what stops this binding
  // from reaching the conversation surface.
  "services": [
    {
      "binding": "AGENTS",
      "service": "ironcage-agents",
      "entrypoint": "DispatchApiEntrypoint",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "COMPUTE",
        "class_name": "BacktestRunner",
        "script_name": "ironcage-compute",
      },
    ],
  },
}
