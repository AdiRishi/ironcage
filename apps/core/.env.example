# Local development connects straight to a PlanetScale branch. Wrangler reads
# these instead of the Hyperdrive configuration, so this path exercises neither
# pooling nor caching.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_DB="postgres://..."
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_DB_CACHED="postgres://..."

# The key that turns a bank-supplied account number into its stored identity
# HMAC. Generate one with `openssl rand -hex 32`; anything under 32 bytes is
# refused. The deployed Worker holds its own secret, and changing a key that has
# already fingerprinted accounts requires a deliberate re-key job.
MONEY_IDENTITY_KEY=
