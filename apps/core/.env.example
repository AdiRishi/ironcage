# Wrangler connects both local Hyperdrive bindings directly to PlanetScale dev.
# Use the same direct branch connection string for both values.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_DB="postgresql://USER:PASSWORD@HOST/postgres?sslmode=require"
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_DB_CACHED="postgresql://USER:PASSWORD@HOST/postgres?sslmode=require"

MONEY_IDENTITY_KEY="replace-with-at-least-32-random-bytes"
