{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ironcage-agents",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "dev": {
    "port": 8788,
    "inspector_port": 9230,
  },
  // The only binding agents holds. No database, bucket, or Durable Object here
  // is deliberate: it is what makes "agents return data, never actions" wiring
  // rather than policy.
  "services": [
    {
      "binding": "CORE",
      "service": "ironcage-core",
      "entrypoint": "AgentReadApiEntrypoint",
    },
  ],
}
