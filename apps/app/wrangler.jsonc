{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Nitro generates `main` and the asset directory at build time. The rest has
  // to live in a real file rather than Nitro's inline config, which is merged
  // only during a build: in development Wrangler's dev proxy reads this file.
  "name": "ironcage-app",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  // Targeting the entrypoint, not just the Worker, is what stops `CORE` from
  // reaching the agent surface and `AGENTS` from reaching dispatch.
  "services": [
    { "binding": "CORE", "service": "ironcage-core", "entrypoint": "AppApiEntrypoint" },
    {
      "binding": "AGENTS",
      "service": "ironcage-agents",
      "entrypoint": "ConversationApiEntrypoint",
    },
  ],
}
