{
  "extends": "@ironcage/tsconfig/react.json",
  "compilerOptions": {
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "verbatimModuleSyntax": false,
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "nitro.config.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
