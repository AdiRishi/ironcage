{
  "extends": "@ironcage/tsconfig/react.json",
  "compilerOptions": {
    "types": ["vite/client", "vitest/globals", "vitest/jsdom", "@testing-library/jest-dom"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "verbatimModuleSyntax": false
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "nitro.config.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
