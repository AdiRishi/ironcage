{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ironcage-engine",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "ENGINE", "class_name": "EngineDurableObject" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["EngineDurableObject"] }],
  "observability": { "enabled": true },
  // Arrives with M0 data collection / M2 dry run — create the resources, then uncomment:
  // "d1_databases": [{ "binding": "DB", "database_name": "ironcage", "database_id": "TODO" }],
  // "r2_buckets": [{ "binding": "HISTORY", "bucket_name": "ironcage-history" }]
}
