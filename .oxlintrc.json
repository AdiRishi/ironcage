{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // `plugins` overwrites oxlint's base set rather than adding to it, so the
  // four defaults (eslint, typescript, unicorn, oxc) have to be re-listed here.
  // Everything after them is opt-in and chosen for this stack.
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "promise",
    "node",
    "react",
    "jsx-a11y",
    "vitest"
  ],
  // `correctness` is the only category oxlint enables by default. The others,
  // in rough order of how noisy they get: suspicious, perf, pedantic, style,
  // restriction, nursery.
  "categories": {
    "correctness": "error"
  },
  "options": {
    // `tsc` remains the authoritative typecheck. This enables the semantic
    // information needed by type-aware lint rules without duplicating it.
    "typeAware": true
  },
  "env": {
    "builtin": true,
    "browser": true,
    "node": true,
    "vitest": true
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    // Workers can be terminated after a response, so unhandled asynchronous
    // work is a correctness error rather than a stylistic preference.
    "typescript/no-floating-promises": ["error", { "ignoreVoid": false }],
    "typescript/no-misused-promises": "error",
    // `Effect.catch(effect, handler)` is a member call named `catch` with two
    // arguments, which this rule reads as a misuse of `Promise.catch`. It
    // cannot tell the two apart, and the Effect form is everywhere.
    "promise/valid-params": "off",
    // `@effect/vitest` supplies `it.effect` and friends. Without listing them
    // the rule treats every assertion inside one as standalone.
    "vitest/no-standalone-expect": [
      "error",
      { "additionalTestBlockFunctions": ["it.effect", "it.live", "it.scoped", "it.scopedLive"] }
    ]
  },
  "settings": {
    "react": {
      "version": "19.2.8"
    }
  },
  "overrides": [
    {
      // These files are written by the shadcn CLI and are never edited by
      // hand, so a lint error here has no legal fix — it can only be silenced
      // or it blocks the next `shadcn add`. The components are changed through
      // theme tokens and composition instead; see
      // `docs/adr/0003-frontend-file-and-folder-conventions.md`.
      "files": ["packages/ui/src/components/**"],
      "rules": {
        "jsx-a11y/label-has-associated-control": "off",
        // Base UI renders its own elements and sets the matching ARIA role on
        // them; the rule cannot see through the primitive to know the role is
        // already correct.
        "jsx-a11y/prefer-tag-over-role": "off"
      }
    }
  ],
  "ignorePatterns": [".repos", ".repos/**", "**/*.gen.ts", "**/worker-configuration.d.ts"]
}
