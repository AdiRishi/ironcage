{
  "name": "ironcage",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "cf-typegen": "turbo cf-typegen",
    "check": "oxfmt && oxlint --disable-nested-config --fix && turbo typecheck",
    "dev": "turbo dev",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --disable-nested-config",
    "sync:repos": "node scripts/sync-reference-repos.ts",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "verify": "oxfmt --check && oxlint --disable-nested-config && turbo typecheck test build"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "yaml": "catalog:"
  },
  "engines": {
    "node": "^24"
  },
  "packageManager": "pnpm@11.20.0"
}
