{
  "name": "ironcage",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "cf-typegen": "turbo cf-typegen",
    "cf-typegen:check": "turbo cf-typegen:check",
    "check": "oxfmt && turbo compile && oxlint --disable-nested-config --fix && turbo typecheck",
    "compile": "turbo compile",
    "dev": "turbo dev",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "turbo compile && oxlint --disable-nested-config",
    "sync:repos": "node scripts/sync-reference-repos.ts",
    "test": "turbo test",
    "test:integration": "turbo test:integration",
    "typecheck": "turbo typecheck",
    "verify": "oxfmt --check && turbo compile && oxlint --disable-nested-config && turbo cf-typegen:check typecheck test build test:integration",
    "migrate": "node scripts/migrate.ts",
    "migrate:apply": "node scripts/migrate.ts --apply"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "yaml": "catalog:"
  },
  "engines": {
    "node": "^24"
  },
  "packageManager": "pnpm@11.20.0"
}
