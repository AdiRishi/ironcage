{
  "name": "ironcage",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "check": "oxfmt && pnpm compile && oxlint --disable-nested-config --fix && turbo typecheck",
    "compile": "turbo compile",
    "deploy": "pnpm --filter @ironcage/infra deploy",
    "dev": "turbo dev --filter @ironcage/infra",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "pnpm compile && oxlint --disable-nested-config",
    "plan": "pnpm --filter @ironcage/infra plan",
    "sync:repos": "node scripts/sync-reference-repos.ts",
    "test": "turbo test",
    "test:integration": "turbo test:integration",
    "typecheck": "turbo typecheck",
    "verify": "oxfmt --check && pnpm compile && oxlint --disable-nested-config && turbo typecheck test build test:integration"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "yaml": "catalog:"
  },
  "engines": {
    "node": "^24"
  },
  "packageManager": "pnpm@11.20.0"
}
