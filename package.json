{
  "name": "ironcage",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "check": "pnpm compile && oxlint --disable-nested-config && oxfmt --check",
    "compile": "turbo compile",
    "deploy": "pnpm --filter @ironcage/infra deploy",
    "dev": "turbo dev --filter @ironcage/infra",
    "docs:build": "blume build",
    "docs:dev": "blume dev",
    "docs:doctor": "blume doctor",
    "fix": "pnpm compile && oxlint --disable-nested-config --fix && oxfmt",
    "plan": "pnpm --filter @ironcage/infra plan",
    "sync:repos": "node scripts/sync-reference-repos.ts",
    "test": "turbo test test:integration",
    "test:integration": "turbo test:integration",
    "typecheck": "turbo typecheck"
  },
  "dependencies": {
    "blume": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "yaml": "catalog:"
  },
  "engines": {
    "node": "^24"
  },
  "packageManager": "pnpm@11.20.0"
}
