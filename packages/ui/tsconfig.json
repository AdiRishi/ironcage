{
  "extends": "@ironcage/tsconfig/react.json",
  "compilerOptions": {
    "paths": {
      "@ironcage/ui/*": ["./src/*"]
    },
    // Every file in this package is written by the shadcn CLI and is never
    // edited by hand, so an unused import upstream ships with (scroll-area.tsx
    // imports React and never uses it) has no fix available here — the only
    // options are to silence it or to stop updating the component. Nothing
    // hand-written lives in this package, so the check has nothing left to
    // protect. See `docs/adr/0003-frontend-file-and-folder-conventions.md`.
    "noUnusedLocals": false,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
