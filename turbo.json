{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": [".nvmrc", "pnpm-lock.yaml", "pnpm-workspace.yaml"],
  "tasks": {
    "compile": {
      "dependsOn": ["^compile"],
      "outputs": ["dist/**"]
    },
    "build": {
      "dependsOn": ["^compile"],
      "outputs": ["dist/**"]
    },
    "@ironcage/agents#build": {
      "outputs": []
    },
    "@ironcage/compute#build": {
      "outputs": []
    },
    "@ironcage/core#build": {
      "outputs": []
    },
    "@ironcage/infra#build": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^compile"]
    },
    "typecheck": {
      "dependsOn": ["^compile"]
    },
    "test": {
      "dependsOn": ["^compile"]
    },
    "test:integration": {
      "dependsOn": ["^compile"],
      "cache": false
    },
    "deploy": {
      "cache": false,
      "dependsOn": ["build"]
    }
  }
}
