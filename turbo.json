{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": [".nvmrc", "pnpm-lock.yaml", "pnpm-workspace.yaml"],
  "tasks": {
    "compile": {
      "dependsOn": ["^compile"],
      "outputs": ["dist/**"]
    },
    "build": {
      "dependsOn": ["^compile"],
      "outputs": [".output/**", ".nitro/**", ".wrangler/deploy/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^compile"]
    },
    "typecheck": {
      "dependsOn": ["^compile"]
    },
    "test": {
      "dependsOn": ["^compile"]
    },
    "deploy": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "preview:worker": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["build"]
    },
    "cf-typegen": {
      "cache": false,
      "outputs": ["worker-configuration.d.ts"]
    }
  }
}
