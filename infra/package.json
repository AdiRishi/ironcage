{
  "name": "@ironcage/infra",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./worker-bindings": {
      "types": "./src/worker-bindings.ts",
      "default": "./src/worker-bindings.ts"
    }
  },
  "scripts": {
    "build": "tsc --noEmit",
    "deploy": "alchemy deploy --stage prod",
    "deploy:dev": "alchemy deploy --stage dev",
    "dev": "alchemy dev --stage dev --env-file .env",
    "plan": "alchemy plan --stage prod",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests"
  },
  "dependencies": {
    "@distilled.cloud/cloudflare": "catalog:",
    "alchemy": "catalog:",
    "effect": "catalog:",
    "pg": "catalog:",
    "vite": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@ironcage/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
